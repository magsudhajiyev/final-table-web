{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/cron-founder-call",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron-daily-stats",
      "schedule": "5 0 * * *"
    },
    {
      "path": "/api/cron-send-times",
      "schedule": "20 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/reset_password",
      "destination": "/reset_password.html"
    },
    {
      "source": "/hand/:shareId",
      "destination": "/index.html"
    },
    {
      "source": "/blog",
      "destination": "/index.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    },
    {
      "source": "/delete-account",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/hand/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
